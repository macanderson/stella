        "name": "bash",
        "input": {
          "command": "mkdir -p /app/caffe/build && cd /app/caffe/build && cmake \\\n  -DCPU_ONLY=ON \\\n  -DUSE_OPENCV=OFF \\\n  -DBUILD_python=OFF \\\n  -DBUILD_python_layer=OFF \\\n  -DUSE_NCCL=OFF \\\n  -DUSE_LEVELDB=ON \\\n  -DUSE_LMDB=ON \\\n  -DBUILD_docs=OFF \\\n  -DCMAKE_BUILD_TYPE=Release \\\n  .. 2>&1 | tail -40; echo \"CMAKE_EXIT=${PIPESTATUS[0]}\"",
