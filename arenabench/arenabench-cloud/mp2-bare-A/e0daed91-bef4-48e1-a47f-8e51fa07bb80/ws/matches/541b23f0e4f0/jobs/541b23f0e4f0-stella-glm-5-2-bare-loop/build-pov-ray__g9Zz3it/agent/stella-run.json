      "diff": "@@ -1,0 +1,443 @@\n+// Persistence Of Vision raytracer version 2.0 sample file.\n+\n+// Spline Object : Merry.inc -This file is used with Spline.pov\n+\n+// This is a huge word \"Merry\" written in cursive. Very festive. \n+// Created with a program I wrote for personal use that converts \n+// b-spline and bezier curves into a group of spheres. \n+// - Drew Wells 1990 \n+//   cis 73767,1244 \n+\n+\n+#declare Merry = union {\n+   sphere { <24.950000, 91.780000, 0.0>, 5.0 }\n+   sphere { <25.846164, 91.746188, 0.0>, 5.0 }\n+   sphere { <26.719312, 91.629504, 0.0>, 5.0 }\n+   sphere { <27.546428, 91.407076, 0.0>, 5.0 }\n+   sphere { <28.304496, 91.056032, 0.0>, 5.0 }\n+   sphere { <28.970500, 90.553500, 0.0>, 5.0 }\n+   sphere { <29.521424, 89.876608, 0.0>, 5.0 }\n+   sphere { <29.934252, 89.002484, 0.0>, 5.0 }\n+   sphere { <30.185968, 87.908256, 0.0>, 5.0 }\n+   sphere { <30.253556, 86.571052, 0.0>, 5.0 }\n+   sphere { <30.114000, 84.968000, 0.0>, 5.0 }\n+   sphere { <29.752348, 83.076052, 0.0>, 5.0 }\n+   sphere { <29.180784, 80.912416, 0.0>, 5.0 }\n+   sphere { <28.419396, 78.495404, 0.0>, 5.0 }\n+   sphere { <27.488272, 75.843328, 0.0>, 5.0 }\n+   sphere { <26.407500, 72.974500, 0.0>, 5.0 }\n+   sphere { <25.197168, 69.907232, 0.0>, 5.0 }\n+   sphere { <23.877364, 66.659836, 0.0>, 5.0 }\n+   sphere { <22.468176, 63.250624, 0.0>, 5.0 }\n+   sphere { <20.989692, 59.697908, 0.0>, 5.0 }\n+   sphere { <19.462000, 56.020000, 0.0>, 5.0 }\n+   sphere { <17.902512, 52.228532, 0.0>, 5.0 }\n+   sphere { <16.346096, 48.408256, 0.0>, 5.0 }\n+   sphere { <14.825824, 44.640364, 0.0>, 5.0 }\n+   sphere { <13.374768, 41.006048, 0.0>, 5.0 }\n+   sphere { <12.026000, 37.586500, 0.0>, 5.0 }\n+   sphere { <10.812592, 34.462912, 0.0>, 5.0 }\n+   sphere { <9.767616, 31.716476, 0.0>, 5.0 }\n+   sphere { <8.924144, 29.428384, 0.0>, 5.0 }\n+   sphere { <8.315248, 27.679828, 0.0>, 5.0 }\n+   sphere { <7.974000, 26.552000, 0.0>, 5.0 }\n+   sphere { <7.919824, 26.091820, 0.0>, 