      "diff": "@@ -20,5 +20,5 @@\n-CFLAGS=\t\t-pipe -m386 -c -O2 -ffast-math -funroll-loops -fcaller-saves -fomit-frame-pointer -finline-functions\n-LFLAGS =\t-O2 -L/usr/X386/lib\n-CC =            gcc\n-BINDIR = ../bin\n-INSTBIN = $(HOME)/bin\n+CFLAGS=\t\t-pipe -c -O2 -ffast-math -funroll-loops -fomit-frame-pointer -finline-functions\n+LFLAGS =\t-O2\n+CC =            gcc\n+BINDIR = ../bin\n+INSTBIN = /usr/local/bin\n"
