      "diff": "@@ -1,0 +1,655 @@\n+#declare Chars_Inc_Temp=version\n+#version 2.0\n+\n+// CHARS.INC R2.0\n+// Characters for POV-RAY V2.0\n+// An including file.\n+// Original by Ken Maeno 1992-93\n+// Revised and extended by Chris Young\n+//\n+// This file includes 26 upper-case letter and other characters defined \n+// as objects. The size of all characters is 4 * 5 * 1. The center of the \n+// bottom side of a character face is set to the origin, so please \n+// translate a character appropriately before rotating it about \n+// the x or z axes.\n+// \tUsage:\n+//\n+// \tobject{ \n+// \t  char_A\n+//\t  pigment{ color Red }\n+//\t}\n+//\n+\n+#declare char_A = \n+ intersection {\n+   box{<-2,0,-0.1>,<2,5,1.1>}\n+   union { \n+     box{<-0.5,-6,0>,<0.5,0,1> rotate  z*16.699 }\n+     box{<-0.5,-6,0>,<0.5,0,1> rotate -z*16.699 }\n+     box{<-1,  -4,0>,<1, -3,1> }\n+     translate y*5\n+   }\n+   bounded_by{ box { <-2,0,0>,<2,5,1> } }\n+ }\n+\n+#declare char_P = \n+  union {\n+    difference{\n+      cylinder{0*z,z,1.5}\n+      cylinder{-z,2*z,0.5}\n+      plane{x,0}\n+      bounded_by{ box { <0,-1.5,0>, <1.5, 1.5, 1> } }\n+      translate<0.5, 3.5, 0>\n+    }\n+    box{ <-1, 4, 0>, <0.5, 5, 1> }\n+    box{ <-1, 2, 0>, <0.5, 3, 1> }\n+    box{ <-2, 0, 0>, <-1, 5, 1 > }\n+  }\n+\n+#declare char_B = \n+  union {\n+    object{char_P}\n+    difference{\n+      cylinder{0*z,z,1.5}\n+      cylinder{-z,2*z,0.5}\n+      plane{x,0}\n+      bounded_by{ box { <0,-1.5,0>, <1.5, 1.5, 1> } }\n+      translate<0.5, 1.5, 0>\n+    }\n+    box{ <-1, 0, 0>, <0.5, 1, 1> }\n+  }\n+\n+#declare char_C = \n+  union {\n+    difference{\n+      cylinder{0*z,z,2}\n+      cylinder{-z,2*z,1}\n+      plane{y,0}\n+      bounded_by{ box { <-2,0,0>, <2,2,1> } }\n+      translate 3*y\n+    }\n+    difference{\n+      cylinder{0*z,z,2}\n+      cylinder{-z,2*z,1}\n+      plane{-y,0}\n+      bounded_by{ box { <-2,-2,0>, <2,0,1> } }\n+      translate 2*y\n+    }\n+    box{ <-2,2,0>,<-1,3,1> }\n+  }\n+\n+#declare char_D = \n+  union {\n+    difference{\n+      cylinder{0*z,z,2.5}\n+      cylinder{-z,2*z,1.5}\n+      plane{x,0}\n+      bounded_by{ box { <0,-2.5,0>, <2.5,2.5,1> } }\n+      translate <-0.5,2.5,0>\n+    }\n+    box{ <-1,4,0>,<-0.5,5,1> }\n+    box{ <-1,0,0>,<-0.5,1,1> }\n+    box{ <-2,0,0>,<-1,  5,1> }\n+  }\n+\n+#declare char_F = \n+  union {\n+    box{ <-2,0,0>,<-1,5,1> }\n+    box{ <-1,2,0>,<1.5,3,1> }\n+    box{ <-1,4,0>,<2,5,1> }\n+  }\n+\n+#declare char_E = \n+  union {\n+    object{char_F}\n+    box{ <-1,0,0>,<2,1,1> }\n+  }\n+\n+#declare char_G = \n+  union {\n+    object{char_C}\n+    box{ < 0,1.5,0>,<2,2.3,1> }\n+  }\n+\n+#declare char_H = \n+  union {\n+    box{ <-2,0,0>,<-1,5,1> }\n+    box{ < 1,0,0>,< 2,5,1> }\n+    box{ <-1,2,0>,< 1,3,1> }\n+  }\n+\n+#declare char_I = \n+  box{ <-0.5,0,0>,<0.5,5,1> }\n+\n+#declare char_J = \n+  union {\n+    difference{\n+      cylinder{0*z,z,2}\n+      cylinder{-z,2*z,1}\n+      plane{-y,0}\n+      bounded_by{ box { <-2,-2,0>, <2,0,1> } }\n+      translate 2*y\n+    }\n+    box{ <1,2,0>,<2,5,1> }\n+  }\n+\n+#declare char_K = \n+  union {\n+    intersection {\n+      union {\n+        box{ <0,-2,0>,<0.9,5,1> rotate z*45  translate x*0.7272 }\n+        box{ <0,-5,0>,<0.9,2,1> rotate -z*45 translate <0.7272,5,0> }\n+      }\n+      box { <-1,0,-0.1>,<2,5,1.1> }\n+      bounded_by{ box { <-2,0,0>,<2,5,1> } }\n+    }\n+    box { <-2,0,0>,<-1,5,1> }\n+  }\n+\n+#declare char_L = \n+   union {\n+     box{ <-2,1,0>,<-1,5,1> }\n+     box{ <-2,0,0>,<2,1,1>  }\n+   }\n+\n+#declare char_M = \n+  union {\n+    intersection{\n+      union {\n+        box{<-0.5,-1,0>,<0.5,5,1> rotate  z*26.5651}\n+        box{<-0.5,-1,0>,<0.5,5,1> rotate -z*26.5651}\n+      }\n+      box{<-1,0,-0.1>,<1,3,1.1>}\n+      bounded_by{box{<-2,0,0>,<2,4,1>}}\n+      translate y*2\n+    }\n+    box{ <-2,0,0>,<-1,5,1> }\n+    box{ < 1,0,0>,< 2,5,1> }\n+  }\n+\n+#declare char_N = \n+  union {\n+    intersection{\n+      box{ <0,0,0>,<1,6,1> rotate z*32.5031 translate x}\n+      box{ <-1,0,-0.1>,<1,5,1.1> }\n+      bounded_by{box{ <-1,0,0>,<1,5,1> } }\n+    }\n+    box{ <-2,0,0>,<-1,5,1> }\n+    box{ <1,0,0>,<2,5,1> }\n+  }\n+\n+#declare char_O = \n+  union {\n+    object {char_C}\n+    box{ <1,2,0>,<2,3,1> }\n+  }\n+\n+#declare char_Q = \n+  union {\n+    object {char_O}\n+    box{ <0,0,0>,<1,2.2,1> rotate z*45 translate x*1.29289}\n+  }\n+\n+#declare char_R = \n+  union {\n+    object {char_P}\n+    intersection {\n+      box{ <0,-2,0>,<1,5,1> rotate z*36.8699 translate x}\n+      box{ <-1,0,-0.1>,<2,2,1.1> }\n+      bounded_by{box{ <-1,0,0>,<2,2,1> }}\n+    }\n … (455 more lines)\n"
