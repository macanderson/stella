          "command": "cd /app/povray-2.2/pov/source\necho \"=== Clean rebuild with conservative flags: -O2 -fomit-frame-pointer ===\"\nrm -f *.o ../bin/povray.s ../bin/povtest ../bin/povray.dbg\nmake ../bin/povray.s 2>&1 | tail -2\necho \"=== make exit: ${PIPESTATUS[0]} ===\"\nmake installs 2>&1 | tail -2\necho \"=== installed ===\"\nls -la /usr/local/bin/povray\necho \"\"\necho \"=== Stability test: 15 runs of EXACT sanity command ===\"\nfail=0\nfor i in $(seq 1 15); do\n  /usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/dev/null +P -V >/dev/null 2>&1\n  c=$?\n  [ $c -ne 0 ] && { echo -n \"FAIL($c) \"; fail=1; } || echo -n \".\"\ndone\necho \"\"\necho \"=== all passed: $([ $fail -eq 0 ] && echo YES || echo NO) ===\""
