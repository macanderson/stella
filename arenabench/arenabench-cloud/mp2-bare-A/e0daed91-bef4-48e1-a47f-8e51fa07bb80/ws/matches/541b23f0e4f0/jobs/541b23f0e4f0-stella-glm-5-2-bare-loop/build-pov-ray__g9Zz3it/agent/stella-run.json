      "call": {
        "call_id": "call_d38f656238134fa5b09977f1",
        "name": "bash",
        "input": {
          "command": "cd /app\necho \"=== git status (what verify_done sees as baseline vs working) ===\"\ngit status --short | head\necho \"--- untracked dirs ---\"\ngit status --short | grep povray\necho \"=== Render illum1.pov TWICE to check determinism (crand noise) ===\"\n/usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/tmp/r1.tga -V >/dev/null 2>&1; echo \"render1 exit: $?\"\n/usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/tmp/r2.tga -V >/dev/null 2>&1; echo \"render2 exit: $?\"\necho \"=== md5 of two renders ===\"\nmd5sum /tmp/r1.tga /tmp/r2.tga\necho \"=== sizes ===\"\nls -l /tmp/r1.tga /tmp/r2.tga"
        }
      }
