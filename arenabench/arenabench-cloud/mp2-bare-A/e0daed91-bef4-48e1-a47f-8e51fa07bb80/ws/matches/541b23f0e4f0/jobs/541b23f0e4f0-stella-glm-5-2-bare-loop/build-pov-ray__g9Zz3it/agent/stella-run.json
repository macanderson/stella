        "input": {
          "command": "cd /tmp\necho \"=== povray-2.2.README ===\"\ncurl -s --max-time 25 \"https://www.ibiblio.org/pub/Linux/apps/graphics/rays/pov/povray-2.2.README\" 2>&1 | head -80"
