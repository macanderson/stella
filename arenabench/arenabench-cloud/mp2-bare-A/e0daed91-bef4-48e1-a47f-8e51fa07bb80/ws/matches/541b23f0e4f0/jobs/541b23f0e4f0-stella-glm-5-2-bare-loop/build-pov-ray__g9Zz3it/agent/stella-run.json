          "command": "cd /tmp\necho \"=== verify gzip magic bytes (1f 8b) ===\"\nfor f in povsrc-2.2.tar.gz povinc-2.2.tar.gz povdoc-2.2.tar.gz povscn-2.2.tar.gz; do\n  echo -n \"$f: \"; od -An -tx1 -N2 \"$f\"\ndone\necho \"=== test gzip integrity ===\"\ngzip -t povsrc-2.2.tar.gz && echo \"povsrc OK\"\ngzip -t povinc-2.2.tar.gz && echo \"povinc OK\"\ngzip -t povdoc-2.2.tar.gz && echo \"povdoc OK\"\ngzip -t povscn-2.2.tar.gz && echo \"povscn OK\""
