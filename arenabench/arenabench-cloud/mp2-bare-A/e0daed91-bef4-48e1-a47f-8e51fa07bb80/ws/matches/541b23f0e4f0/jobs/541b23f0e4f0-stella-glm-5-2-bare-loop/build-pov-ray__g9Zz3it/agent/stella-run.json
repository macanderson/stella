      "type": "tool_start",
      "call": {
        "call_id": "call_e1e6158a920140419142759e",
        "name": "bash",
        "input": {
          "command": "echo \"=== Test A: +O/dev/null, 8 runs ===\"\nfor i in $(seq 1 8); do\n  /usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/dev/null +P -V >/dev/null 2>&1\n  echo -n \"$? \"\ndone\necho \"\"\necho \"=== Test B: +O real file, 8 runs ===\"\nfor i in $(seq 1 8); do\n  /usr/local/bin/povray +L/app/povray-2.2/povdoc/include +I/app/deps/illum1.pov +O/tmp/r.tga -V >/dev/null 2>&1\n  echo -n \"$? \"\ndone\necho \"\""
        }
