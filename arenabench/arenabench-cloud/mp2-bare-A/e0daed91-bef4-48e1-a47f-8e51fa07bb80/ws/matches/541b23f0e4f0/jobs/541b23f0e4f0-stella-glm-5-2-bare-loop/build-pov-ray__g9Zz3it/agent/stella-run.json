          "command": "echo \"=== Searching github for POV-Ray 2.2 source ===\"\n# Search GitHub API for povray 2.2 repos\ncurl -s --max-time 20 \"https://api.github.com/search/repositories?q=povray+2.2\" 2>&1 | grep -o '\"full_name\": *\"[^\"]*\"' | head -20"
