 gif \"stars.gif\" /*640x400*/ }\n+   //      scale <100.0, 100.0, 100.0>\n+   //  }\n+   pigment { Black }\n+   finish {\n+      ambient 1.0\n+      diffuse 0.0\n+   }\n+}\n+\n+light_source { <-200.0, 200.0, -200.0> colour White }\n"
