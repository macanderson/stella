          "content": "     1\t# Makefile for Persistence of Vision Raytracer\n     2\t# This file is released to the public domain.\n     3\t#\n     4\t# make all \t\tcreates the executables\n     5\t# make installx \tinstalls the X binary\n     6\t# make installs \tinstalls the standard binary\n     7\t# make installv\t\tinstalls the svgalib binary -- YOU MUST BE ROOT TO DO THIS\n     8\t#\n     9\t# MAKE Macros and Such...\n    10\t#\n    11\t\n    12\t#***************************************************************\n    13\t#*\n    14\t#*                      UNIX Makefile\n    15\t#*\n    16\t#***************************************************************\n    17\t\n    18\t\n    19\tOBJ\t= o\n    20\tCFLAGS=\t\t-pipe -m386 -c -O2 -ffast-math -funroll-loops -fcaller-saves -fomit-frame-pointer -finline-functions\n    21\tLFLAGS =\t-O2 -L/usr/X386/lib\n    22\tCC =            gcc\n    23\tBINDIR = ../bin\n    24\tINSTBIN = $(HOME)/bin\n    25\t\n    26\t# Make's implicit rules for making a .o file from a .c file...\n    27\t#\n    28\t.c.o :\n    29\t\t$(CC) $(CFLAGS) $*.c\n    30\t\n    31\t\n    32\tPOVOBJS = povray.$(OBJ) bezier.$(OBJ) blob.$(OBJ) bound.$(OBJ) boxes.$(OBJ)  \\\n    33\t\t  camera.$(OBJ) colour.$(OBJ) cones.$(OBJ) csg.$(OBJ) discs.$(OBJ)   \\\n    34\t\t  dump.$(OBJ) express.$(OBJ) gif.$(OBJ) gifdecod.$(OBJ)              \\\n    35\t\t  hfield.$(OBJ) iff.$(OBJ) image.$(OBJ) lighting.$(OBJ)              \\\n    36\t\t  matrices.$(OBJ) normal.$(OBJ) objects.$(OBJ) parse.$(OBJ)          \\\n    37\t\t  pigment.$(OBJ) planes.$(OBJ) point.$(OBJ) poly.$(OBJ)              \\\n    38\t\t  quadrics.$(OBJ) raw.$(OBJ) ray.$(OBJ) render.$(OBJ) spheres.$(OBJ) \\\n    39\t\t  targa.$(OBJ) texture.$(OBJ) tokenize.$(OBJ) triangle.$(OBJ)        \\\n    40\t\t  txttest.$(OBJ) vect.$(OBJ)\n    41\t\n    42\tall: $(BINDIR)/povray.x $(BINDIR)/povray.s $(BINDIR)/povray.v\n    43\t\n    44\tpovray.x: $(BINDIR)/povray.x\n    45\tpovray.s: $(BINDIR)/povray.s\n    46\tp