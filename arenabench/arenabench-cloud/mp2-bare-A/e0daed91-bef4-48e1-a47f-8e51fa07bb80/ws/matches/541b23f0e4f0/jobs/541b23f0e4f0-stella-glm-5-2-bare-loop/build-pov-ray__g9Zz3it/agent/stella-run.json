      "removed": 0,
      "diff": "@@ -1,0 +1,36 @@\n+// Persistence Of Vision raytracer version 2.0 sample file.\n+\n+// Sample qaurtic file \n+// by Alexander Enzmann\n+\n+#include \"shapes.inc\"\n+#include \"colors.inc\"\n+#include \"textures.inc\"\n+#include \"shapesq.inc\"\n+\n+object {\n+   Piriform\n+   sturm\n+   rotate -90*z\n+   translate 0.5*y\n+   scale <2, 10, 2>\n+\n+   texture {\n+      pigment { SteelBlue }\n+      finish {\n+         phong 1.0\n+         phong_size 20\n+         ambient 0.2\n+         diffuse 0.8\n+      }\n+   }\n+}\n+\n+camera {\n+   location  <0.0, 0.0, -12.0>\n+   up        <0.0, 1.0,  0.0>\n+   right     <4/3, 0.0,  0.0>\n+   look_at   <0.0, 0.0,  0.0>\n+}\n+\n+light_source { <200, 30, -500> colour White }\n"
