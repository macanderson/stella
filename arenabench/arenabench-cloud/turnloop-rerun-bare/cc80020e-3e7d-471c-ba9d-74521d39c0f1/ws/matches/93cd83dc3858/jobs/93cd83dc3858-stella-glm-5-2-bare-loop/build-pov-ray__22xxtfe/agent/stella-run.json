      "diff": "@@ -1,0 +1,79 @@\n+$ define sys sys$include:\n+$ cc/nolist BEZIER\n+$ cc/nolist BLOB\n+$ cc/nolist BOUND\n+$ cc/nolist BOXES\n+$ cc/nolist CAMERA\n+$ cc/nolist COLOUR\n+$ cc/nolist CONES \n+$ cc/nolist CSG\n+$ cc/nolist DISCS\n+$ cc/nolist DUMP\n+$ cc/nolist EXPRESS\n+$ cc/nolist GIF\n+$ cc/nolist GIFDECOD\n+$ cc/nolist HFIELD\n+$ cc/nolist IFF\n+$ cc/nolist IMAGE\n+$ cc/nolist LIGHTING\n+$ cc/nolist MATRICES\n+$ cc/nolist NORMAL  \n+$ cc/nolist OBJECTS\n+$ cc/nolist PARSE\n+$ cc/nolist PIGMENT\n+$ cc/nolist PLANES\n+$ cc/nolist POINT\n+$ cc/nolist POLY\n+$ cc/nolist POVRAY\n+$ cc/nolist QUADRICS\n+$ cc/nolist RAW\n+$ cc/nolist RAY\n+$ cc/nolist RENDER\n+$ cc/nolist SPHERES\n+$ cc/nolist TARGA\n+$ cc/nolist TEXTURE\n+$ cc/nolist TOKENIZE\n+$ cc/nolist TRIANGLE\n+$ cc/nolist TXTTEST\n+$ cc/nolist VAX\n+$ cc/nolist VECT\n+$ link/nomap/exe=povray -\n+POVRAY         , -\n+BEZIER         , -\n+BLOB           , -\n+BOUND          , -\n+BOXES          , -\n+CAMERA         , -\n+COLOUR         , -\n+CONES          , -\n+CSG            , -\n+DISCS          , -\n+DUMP           , -\n+EXPRESS        , -\n+GIF            , -\n+GIFDECOD       , -\n+HFIELD         , -\n+IFF            , -\n+IMAGE          , -\n+LIGHTING       , -\n+MATRICES       , -\n+NORMAL         , -\n+OBJECTS        , -\n+PARSE          , -\n+PIGMENT        , -\n+PLANES         , -\n+POINT          , -\n+POLY           , -\n+QUADRICS       , -\n+RAW            , -\n+RAY            , -\n+RENDER         , -\n+SPHERES        , -\n+TARGA          , -\n+TEXTURE        , -\n+TOKENIZE       , -\n+TRIANGLE       , -\n+TXTTEST        , -\n+VAX            , -\n+VECT\n+$ exit\n"
