41\n+#define ROTATE_TOKEN            142\n+#define ROUGHNESS_TOKEN         143\n+#define SCALE_TOKEN             144\n+#define SEMI_COLON_TOKEN        145\n+#define SINGLE_QUOTE_TOKEN      146\n … (50 more lines)\n"
