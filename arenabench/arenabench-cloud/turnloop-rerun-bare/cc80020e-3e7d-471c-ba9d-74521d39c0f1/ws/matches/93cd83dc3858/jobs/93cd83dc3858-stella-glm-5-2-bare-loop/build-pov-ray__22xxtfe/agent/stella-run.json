        "name": "bash",
        "input": {
          "command": "cd /app\n# Let me check what default branches those repos use and their trees\nfor repo in susam/pov25 TheAwesomePossum/VisualPOVray; do\n  echo \"=== $repo ===\"\n  br=$(curl -sL --max-time 15 \"https://api.github.com/repos/$repo\" 2>/dev/null | grep -oE '\"default_branch\": *\"[^\"]*\"' | head -1)\n  echo \"default_branch: $br\"\ndone\necho \"=== susam/pov25 tree (master) raw ===\"\ncurl -sL --max-time 20 \"https://api.github.com/repos/susam/pov25/contents/\" 2>/dev/null | grep '\"name\"' | head -20\n"
        }
      }
    },
