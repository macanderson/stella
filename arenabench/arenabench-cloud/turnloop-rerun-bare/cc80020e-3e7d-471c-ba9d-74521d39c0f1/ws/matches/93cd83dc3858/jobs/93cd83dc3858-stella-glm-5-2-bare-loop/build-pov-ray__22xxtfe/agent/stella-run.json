        "name": "bash",
        "input": {
          "command": "cd /app\n# All these are big ISOs. The source must be INSIDE them.\n# Let me take the most promising: the Walnut Creek Linux Games CD (1999) which is MOST likely \n# to have Unix povray source. But before downloading 310MB, let me verify via the ISO's XML catalog.\n# \n# Actually - a much better approach: archive.org's CDX has the povray.org FTP text files.\n# Let me look for the POV-Ray source distributed on OTHER ftp sites that WERE fully archived.\n# \n# Check x2ftp.oulu.fi (famous game/graphics ftp) snapshots\necho \"=== CDX: x2ftp.oulu.fi povray ===\"\ncurl -sL --max-time 30 \"https://web.archive.org/cdx/search/cdx?url=x2ftp.oulu.fi/*&matchType=prefix&filter=original:.*pov.*&limit=30&output=json&collapse=urlkey\" 2>&1 | head -30\n"
        }
      }
