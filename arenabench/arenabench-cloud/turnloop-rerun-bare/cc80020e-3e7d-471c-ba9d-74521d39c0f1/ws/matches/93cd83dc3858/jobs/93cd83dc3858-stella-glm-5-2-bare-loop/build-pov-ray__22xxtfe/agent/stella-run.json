          "command": "cd /app\n# Hmm, the wildcard prefix needs the exact dir. Let me search for each known file's status\nfor f in POVDOC.ZIP POVSCN.ZIP POVSCN.TAR.Z POVIBM.EXE WHATSNEW.DOC POVINF.DOC KNOWNBUGS.DOC; do\n  echo \"=== $f ===\"\n  curl -sL --max-time 20 \"https://web.archive.org/cdx/search/cdx?url=ftp.povray.org/pub/povray/Old-Versions/Official-2.2/$f&output=json&limit=3&filter=statuscode:226\" 2>&1 | head -3\ndone\n"
        }
      }
    },
