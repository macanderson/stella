        "name": "bash",
        "input": {
          "command": "cd /app\n# _files.xml only lists top-level archive files, not ISO internals. \n# Let me try a smarter approach: check if the Walnut Creek CD has a known file structure.\n# Actually, let me reconsider - the Walnut Creek \"Linux Games\" CD is about GAMES, povray is a renderer/tool.\n# \n# Better lead: Let me search archive.org for the POV-Ray documentation/scenes items that are \n# NOT iso-only, which might contain the source zip.\necho \"=== archive.org: povray + zip + NOT iso ===\"\n# Look for items where original format is ZIP and contains povray\ncurl -sL --max-time 30 \"https://archive.org/advancedsearch.php?q=povray+AND+source&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=mediatype&output=json&rows=50&sort%5B%5D=downloads+desc\" 2>/dev/null | python3 -c \"\nimport sys,json\nd=json.load(sys.stdin)\nprint('numFound:', d['response']['numFound'])\nfor doc in d['response']['docs']:\n    print(doc.get('identifier'),'|',doc.get('mediatype'),'|',doc.get('title','')[:50])\n\""
        }
      }
    },
