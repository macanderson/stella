        "name": "bash",
        "input": {
          "command": "cd /app\n# No gh auth. Let me look at the official povray repo's git history - maybe 2.x source is in early commits\n# The repo might have the full history including pre-3.0\necho \"=== official repo oldest commits ===\"\ncurl -sL --max-time 30 \"https://api.github.com/repos/POV-Ray/povray/commits?per_page=5&page=1\" 2>/dev/null | grep -E '\"sha\"|\"message\"' | head -10\necho \"=== total commits / first commit ===\"\n# Get the last page to find oldest\ncurl -sLI --max-time 20 \"https://api.github.com/repos/POV-Ray/povray/commits?per_page=1\" 2>/dev/null | grep -i \"link:\" \n"
        }
      }
    },
