        "name": "bash",
        "input": {
          "command": "cd /app\n# Search for POVSRC.TAR.Z or POVSRC.ZIP across known static mirror sites\necho \"=== cd.textfiles.com search ===\"\nfor url in \\\n  \"http://cd.textfiles.com/megagames2/POV/\" \\\n  \"http://cd.textfiles.com/1kleung/POVRAY/\" \\\n  \"http://cd.textfiles.com/cdrom51/POV/\" ; do\n  echo \"--- $url ---\"\n  curl -sIL --max-time 12 \"$url\" 2>/dev/null | grep -iE \"HTTP/|content-type\" | head -2\ndone\n"
        }
