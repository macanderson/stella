XPRESS:\th.parse\n+o.GIF:\tc.GIF\n+o.GIF:\th.frame\n+o.GIF:\th.config\n+o.GIF:\th.povproto\n+o.GIFDECOD:\tc.GIFDECOD\n+o.GIFDECOD:\th.frame\n+o.GIFDECOD:\th.config\n+o.GIFDECOD:\th.povproto\n+o.HFIELD:\tc.HFIELD\n+o.HFIELD:\th.frame\n+o.HFIELD:\th.config\n+o.HFIELD:\th.vector\n+o.HFIELD:\th.povproto\n+o.IFF:\tc.IFF\n+o.IFF:\th.frame\n+o.IFF:\th.config\n+o.IFF:\th.povproto\n+o.IMAGE:\tc.IMAGE\n+o.IMAGE:\th.frame\n+o.IMAGE:\th.config\n+o.IMAGE:\th.vector\n+o.IMAGE:\th.povproto\n+o.IMAGE:\th.texture\n+o.LIGHTING:\tc.LIGHTING\n+o.LIGHTING:\th.frame\n+o.LIGHTING:\th.config\n+o.LIGHTING:\th.vector\n+o.LIGHTING:\th.povproto\n+o.MATRICES:\tc.MATRICES\n+o.MATRICES:\th.frame\n+o.MATRICES:\th.config\n+o.MATRICES:\th.vector\n+o.MATRICES:\th.povproto\n+o.NORMAL:\tc.NORMAL\n+o.NORMAL:\th.frame\n+o.NORMAL:\th.config\n+o.NORMAL:\th.vector\n+o.NORMAL:\th.povproto\n+o.NORMAL:\th.texture\n+o.OBJECTS:\tc.OBJECTS\n+o.OBJECTS:\th.frame\n+o.OBJECTS:\th.config\n+o.OBJECTS:\th.vector\n+o.OBJECTS:\th.povproto\n+o.PARSE:\tc.PARSE\n+o.PARSE:\th.frame\n+o.PARSE:\th.config\n+o.PARSE:\th.vector\n+o.PARSE:\th.povproto\n+o.PARSE:\th.parse\n+o.PIGMENT:\tc.PIGMENT\n+o.PIGMENT:\th.frame\n+o.PIGMENT:\th.config\n+o.PIGMENT:\th.vector\n+o.PIGMENT:\th.povproto\n+o.PIGMENT:\th.texture\n+o.PLANES:\tc.PLANES\n+o.PLANES:\th.frame\n+o.PLANES:\th.config\n+o.PLANES:\th.vector\n+o.PLANES:\th.povproto\n+o.POINT:\tc.POINT\n+o.POINT:\th.frame\n+o.POINT:\th.config\n+o.POINT:\th.vector\n+o.POINT:\th.povproto\n+o.POLY:\tc.POLY\n+o.POLY:\th.frame\n+o.POLY:\th.config\n+o.POLY:\th.vector\n+o.POLY:\th.povproto\n+o.POVRAY:\tc.POVRAY\n+o.POVRAY:\th.frame\n+o.POVRAY:\th.config\n+o.POVRAY:\th.povproto\n+o.QUADRICS:\tc.QUADRICS\n+o.QUADRICS:\th.frame\n+o.QUADRICS:\th.config\n+o.QUADRICS:\th.vector\n+o.QUADRICS:\th.povproto\n+o.RAW:\tc.RAW\n+o.RAW:\th.frame\n+o.RAW:\th.config\n+o.RAW:\th.povproto\n+o.RAY:\tc.RAY\n+o.RAY:\th.frame\n+o.RAY:\th.config\n+o.RAY:\th.vector\n+o.RAY:\th.povproto\n+o.RENDER:\tc.RENDER\n+o.RENDER:\th.fram