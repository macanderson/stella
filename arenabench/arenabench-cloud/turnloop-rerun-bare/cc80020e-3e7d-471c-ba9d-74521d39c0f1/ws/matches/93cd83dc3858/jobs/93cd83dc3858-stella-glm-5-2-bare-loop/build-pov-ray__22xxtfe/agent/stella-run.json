        "name": "bash",
        "input": {
          "command": "cd /app\n# Not the source. Let me reconsider the whole approach.\n# \n# The Walnut Creek \"Linux Games CD\" from 1999 very likely contains povray source in /pub or similar.\n# It's a 310MB ISO. Let me check its file listing via the archive.org derivative.\necho \"=== Walnut Creek ISO file listing ===\"\ncurl -sL --max-time 30 \"https://archive.org/metadata/Linux_Games_CD-ROM_Walnut_Creek_July_1999\" 2>/dev/null | python3 -c \"\nimport sys,json\nd=json.load(sys.stdin)\nprint('server dir:', d.get('dir'))\nfor f in d.get('files',[]):\n    print(f.get('name'), f.get('format'), f.get('size'))\n\"\n"
        }
      }
    },
