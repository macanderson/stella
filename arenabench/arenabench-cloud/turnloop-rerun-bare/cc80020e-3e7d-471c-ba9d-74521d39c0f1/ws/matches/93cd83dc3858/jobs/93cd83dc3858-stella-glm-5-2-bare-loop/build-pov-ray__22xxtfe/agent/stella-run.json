        "input": {
          "command": "cd /app\n# Walnut Creek / cd.textfiles.com often hosts these. Let's try the classic locations.\n# The POV-Ray 2.2 unix source was commonly: povsrc22.zip (DOS) and povunix.scr or pvsource\n# Let's try cd.textfiles.com and other mirrors directly\nfor url in \\\n  \"https://cd.textfiles.com/authtic/may96/POVRAY/SOURCE/POVSRC22.ZIP\" \\\n  \"https://cd.textfiles.com/swdiv/dujour/POVSRC22.ZIP\" ; do\n  echo \"=== $url ===\"\n  curl -sIL \"$url\" 2>/dev/null | grep -iE \"HTTP/|content-length|content-type\" | head -5\ndone\n"
        }
      }
    },
