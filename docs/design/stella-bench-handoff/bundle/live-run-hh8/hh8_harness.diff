+  A)   KEY=phaseA; CONC="${TB_CONCURRENCY_A:-3}" ;;
+  B)   KEY=phaseB; CONC=1 ;;
+  ALL) KEY=all;    CONC="${TB_CONCURRENCY:-3}" ;;
